# Salin file ini menjadi .env, lalu isi API key milik Anda.
# Gemini: tanya jawab, penulisan, pendidikan, coding, storyboard.
GEMINI_API_KEY=

# Pollinations: pembuatan gambar cloud; API key/kredit akun diperlukan.
POLLINATIONS_API_KEY=

# Magic Hour: pembuatan video cloud; signup memberi kredit percobaan sesuai ketentuan akun.
MAGIC_HOUR_API_KEY=
MAGIC_HOUR_VIDEO_MODEL=wan-2.2

# Pengaturan Gemini dan gambar.
GEMINI_MODEL=gemini-2.5-flash
POLLINATIONS_MODEL=zimage
