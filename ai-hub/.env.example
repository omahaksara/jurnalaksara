# Salin file ini menjadi .env, lalu isi API key milik Anda.
# Gemini untuk tanya jawab, penulisan, coding, storyboard.
GEMINI_API_KEY=

# Pollinations untuk generasi gambar berbasis cloud (key/kredit akun diperlukan).
POLLINATIONS_API_KEY=

# Opsional: ComfyUI lokal untuk workflow gambar/video.
COMFYUI_URL=http://127.0.0.1:8188

# Pengaturan model (opsional).
GEMINI_MODEL=gemini-2.5-flash
POLLINATIONS_MODEL=zimage
